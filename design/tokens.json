 "androidToggleShape": {
  "$source": "plan section 22, board 35",
  "$status": "Encore tokens. The Compose docs name the shape slots but give no numbers; confirm against the pinned Compose Material 3 version before release.",
  "rule": "Play/pause is a toggle whose checked state is 'is playing'. Unselected or paused = round. Selected or playing = rounded square. Pressed = tighter than both. Like, shuffle and repeat follow the same rule. Use toggleableShapes(shape, pressedShape, checkedShape); never animate radii by hand.",
  "restRadiusPercent": 50,
  "checkedRadiusPercentOfHeight": 33,
  "pressedRadiusPercentOfHeight": 19,
  "sizes": {
   "large": {
    "width": 112,
    "height": 72,
    "checkedRadius": 24,
    "pressedRadius": 14,
    "use": "phone Now Playing play button"
   },
   "medium": {
    "width": 96,
    "height": 60,
    "checkedRadius": 20,
    "use": "Lyrics"
   },
   "bar": {
    "width": 52,
    "height": 52,
    "checkedRadius": 17,
    "use": "tablet and desktop player bar"
   },
   "compact": {
    "width": 44,
    "height": 44,
    "checkedRadius": 15,
    "touchTarget": 48,
    "use": "mini player"
   }
  },
  "transportRow": {
   "gap": 8,
   "prevNext": {
    "width": 88,
    "height": 72,
    "outerRadius": 36,
    "innerRadius": 10,
    "pressedInnerRadius": 4,
    "style": "tonal",
    "shape": "The end the arrow points to is fully round (half the height). The end beside Play is 10 dp. Previous: left round, right 10. Next: right round, left 10. It flips with the arrow in right-to-left languages.",
    "sizes": {
     "medium": {
      "width": 76,
      "height": 60,
      "outerRadius": 30
     },
     "bar": {
      "width": 76,
      "height": 56,
      "outerRadius": 28
     },
     "desktop": {
      "width": 68,
      "height": 52,
      "outerRadius": 26
     }
    }
   },
   "play": {
    "width": 112,
    "height": 72,
    "radius": "state shape"
   },
   "layout": "three separate buttons, not one joined pill. Previous and Next are asymmetric (round on the arrow side), Play is the toggle shape. Bare icon buttons with no container have no visible corners; the ripple, focus ring and tonal fill follow the same shape when they show."
  },
  "stateLayer": {
   "hover": 0.08,
   "pressed": 0.14,
   "disabledContainer": 0.12,
   "disabledContent": 0.38
