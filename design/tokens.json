{
 "$description": "Encore design tokens. Values that appear in the plan or the wireframe boards are copied from them and name their source. Anything marked $status define-in-phase-1 has no agreed number yet and must be derived from the wireframes, then added here. Generate Swift and Dart constants from this file. Android reads Material 3 Expressive motion and shape values from the Compose library, not from here, except where noted.",
 "$units": "Lengths are pt on Apple platforms, dp or sp on Android, logical px in Flutter. Durations are milliseconds unless the key says Seconds.",
 "meta": {
  "codename": "Encore",
  "note": "Placeholder name; see docs/DECISIONS.md. Tokens use no product name."
 },
 "breakpoints": {
  "$source": "plan section 9, board 26 (Size classes and platform rules)",
  "$description": "Layout follows window width, never device type. Every window is resizable.",
  "compact": {
   "min": 0,
   "max": 599
  },
  "medium": {
   "min": 600,
   "max": 839
  },
  "expanded": {
   "min": 840,
   "max": 1199
  },
  "large": {
   "min": 1200
  },
  "railWidth": 80,
  "expandedRailWidth": 240,
  "railFrom": 600,
  "expandedRailFrom": 840
 },
 "grid": {
  "$source": "plan section 9, principle 4",
  "base": 8
 },
 "touchTarget": {
  "$source": "plan sections 16 and 22",
  "ios": 44,
  "android": 48,
  "touchMac": 36,
  "gapBetweenButtons": 8
 },
 "radius": {
  "$source": "board 24 (platform design languages), board 35",
  "albumArtApple": 14,
  "albumArtNote": "Real album art takes one plain radius on all four corners on every platform. Generated-cover shapes are never applied to real art.",
  "androidCard": 28,
  "desktopPane": 28,
  "buttonGroupFacingCorner": 10,
  "buttonGroupOuterCorner": "full (50%)",
  "iosButtonsAndBars": "capsule; nested radii are concentric (inner = outer minus padding)"
 },
 "shape": {
  "$source": "board 24",
  "generatedCover": [
   "cookie",
   "sunny",
   "clover",
   "arch",
   "squircle",
   "pill"
  ],
  "note": "Android and desktop use MaterialShapes for generated playlist and mix covers."
 },
 "androidToggleShape": {
  "$source": "plan section 22, board 35",
  "$status": "Encore tokens. The Compose docs name the shape slots but give no numbers; confirm against the pinned Compose Material 3 version before release.",
  "rule": "Play/pause is a toggle whose checked state is 'is playing'. Unselected or paused = round. Selected or playing = rounded square. Pressed = tighter than both. Like, shuffle and repeat follow the same rule. Use toggleableShapes(shape, pressedShape, checkedShape); never animate radii by hand.",
  "restRadiusPercent": 50,
  "checkedRadiusPercentOfHeight": 33,
  "pressedRadiusPercentOfHeight": 19,
  "sizes": {
   "large": {
    "width": 112,
    "height": 72,
    "checkedRadius": 24,
    "pressedRadius": 14,
    "use": "phone Now Playing play button"
   },
   "medium": {
    "width": 96,
    "height": 60,
    "checkedRadius": 20,
    "use": "Lyrics"
   },
   "bar": {
    "width": 52,
    "height": 52,
    "checkedRadius": 17,
    "use": "tablet and desktop player bar"
   },
   "compact": {
    "width": 44,
    "height": 44,
    "checkedRadius": 15,
    "touchTarget": 48,
    "use": "mini player"
   }
  },
  "transportRow": {
   "gap": 8,
   "prevNext": {
    "width": 88,
    "height": 72,
    "outerRadius": 36,
    "innerRadius": 10,
    "pressedInnerRadius": 4,
    "style": "tonal",
    "shape": "The end the arrow points to is fully round (half the height). The end beside Play is 10 dp. Previous: left round, right 10. Next: right round, left 10. It flips with the arrow in right-to-left languages.",
    "sizes": {
     "medium": {
      "width": 76,
      "height": 60,
      "outerRadius": 30
     },
     "bar": {
      "width": 76,
      "height": 56,
      "outerRadius": 28
     },
     "desktop": {
      "width": 68,
      "height": 52,
      "outerRadius": 26
     }
    }
   },
   "play": {
    "width": 112,
    "height": 72,
    "radius": "state shape"
   },
   "layout": "three separate buttons, not one joined pill. Previous and Next are asymmetric (round on the arrow side), Play is the toggle shape. Bare icon buttons with no container have no visible corners; the ripple, focus ring and tonal fill follow the same shape when they show."
  },
  "stateLayer": {
   "hover": 0.08,
   "pressed": 0.14,
   "disabledContainer": 0.12,
   "disabledContent": 0.38
  },
  "focusRing": {
   "width": 3,
   "gap": 3,
   "showFor": "keyboard, D-pad, Switch Access only"
  }
 },
 "appleButton": {
  "$source": "plan section 22",
  "shapeChange": "none",
  "pressed": "glass lens lifts under the finger",
  "toggledOn": "tinted glass",
  "reduceTransparency": "opaque tinted disc",
  "increaseContrast": "1 pt outline"
 },
 "motion": {
  "$source": "plan sections 9, 16 and 22, board 2 (Motion and haptics)",
  "ios": {
   "springDefault": {
    "responseSeconds": 0.4,
    "damping": 0.85
   },
   "springSnappy": {
    "responseSeconds": 0.25,
    "damping": 0.9,
    "use": "taps, toggles"
   },
   "springHero": {
    "responseSeconds": 0.5,
    "damping": 0.82,
    "use": "Now Playing open and close"
   }
  },
  "android": {
   "source": "MotionScheme.expressive() in the library: fastSpatial (press, toggle, menu), defaultSpatial (sheets), slowSpatial (container transforms), defaultEffects (color, no bounce). Do not copy numbers into the app."
  },
  "refreshRateHz": 120,
  "timing": {
   "visibleFeedbackMaxMs": 100,
   "tapMaxMs": 300,
   "doubleTapWindowMs": 250,
   "longPressAndroidMs": 400,
   "longPressDesktopTouchMs": 500,
   "scrubArmMs": 150,
   "seekThrottleMs": 50,
   "transportDebounceMs": 200,
   "undoToastMs": 5000,
   "lyricAutoScrollResumeMs": 3000,
   "reduceMotionCrossfadeMs": 120,
   "albumColorCrossfadeMs": 600,
   "skeletonShimmerMs": 1200,
   "gradientBlobLoopSeconds": {
    "min": 40,
    "max": 70
   },
   "sleepTimerFadeOutMs": 10000,
   "slopIosPt": 10,
   "slopAndroidDp": 8
  },
  "swipeRow": {
   "armPercent": 25,
   "commitPercent": 60
  },
  "pullToRefreshArmPt": 72,
  "edgeSwipeStartPt": 24,
  "scrubSlowdown": [
   1,
   0.5,
   0.25
  ],
  "blockedActionShake": {
   "amplitude": 4,
   "cycles": 3,
   "durationMs": 240
  },
  "reduceMotion": "Flights, morphs, lifts, springs and shakes become cross-fades. State layers, focus rings and haptics stay.",
  "reduceTransparency": "Solid surfaces instead of glass or blur."
 },
 "haptics": {
  "$source": "plan sections 16 and 22, boards 2 and 35. One haptic per action; ambient motion never vibrates; system haptic settings win; Windows and Linux have none; Mac only for scrub snaps and step changes.",
  "playPauseSkip": {
   "ios": "impact(.soft)",
   "android": "VIRTUAL_KEY"
  },
  "likeOn": {
   "ios": "impact(.medium)",
   "android": "TOGGLE_ON (CONFIRM below API 34)"
  },
  "likeOff": {
   "ios": "impact(.light)",
   "android": "TOGGLE_OFF"
  },
  "doubleTapArtworkLike": {
   "ios": "impact(.medium)",
   "android": "CONFIRM"
  },
  "longPressOpensMenu": {
   "ios": "system context menu haptic",
   "android": "LONG_PRESS"
  },
  "scrubStartEnd": {
   "ios": "selection / impact(.light)",
   "android": "GESTURE_START / GESTURE_END"
  },
  "scanTickEachSecond": {
   "ios": "selection",
   "android": "SEGMENT_FREQUENT_TICK"
  },
  "sliderDetents": {
   "ios": "selection",
   "android": "SEGMENT_FREQUENT_TICK"
  },
  "reorderPickUp": {
   "ios": "impact(.medium)",
   "android": "DRAG_START"
  },
  "reorderDrop": {
   "ios": "impact(.light)",
   "android": "GESTURE_END"
  },
  "swipeArmed": {
   "ios": "impact(.rigid)",
   "android": "GESTURE_THRESHOLD_ACTIVATE"
  },
  "swipeDisarmed": {
   "ios": "selection",
   "android": "GESTURE_THRESHOLD_DEACTIVATE"
  },
  "profileSwitchedHandoffDone": {
   "ios": "notification(.success)",
   "android": "CONFIRM"
  },
  "sleepTimerSet": {
   "ios": "notification(.success)",
   "android": "CONFIRM"
  },
  "destructiveConfirm": {
   "ios": "notification(.warning)",
   "android": "CONFIRM"
  },
  "blockedOrFailed": {
   "ios": "notification(.warning) or (.error)",
   "android": "REJECT"
  },
  "lyricSweepGradientDrift": "none"
 },
 "albumGradient": {
  "$source": "board 4 (Album gradients), plan section 9",
  "sampleSizePx": 64,
  "clusters": 5,
  "clusterSpace": "OKLab k-means",
  "stops": 4,
  "plusDarkBase": true,
  "textContrastMin": 4.5,
  "lightArtTextContrastMin": 7,
  "lightArtRule": "Light art flips to a light field with dark text.",
  "crossfadeMs": 600,
  "sameAlbumKeepsField": true,
  "blobTravelPercentOfWidth": {
   "min": 6,
   "max": 10
  },
  "hueShiftDegrees": 6,
  "ios": "MeshGradient, 4 x 4 control points, animated from TimelineView; layered radial gradients below iOS 18",
  "android": "AGSL RuntimeShader from API 33; blurred radial brushes below",
  "fallbacks": {
   "reduceMotion": "static",
   "reduceTransparencyOrBatterySaver": "solid tint, no blur",
   "missingArt": "profile accent"
