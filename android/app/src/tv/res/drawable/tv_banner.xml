<?xml version="1.0" encoding="utf-8"?>
<!-- Encore TV's launcher banner (320 by 180 dp, Android TV's size): the app icon's Iris
     background with the repeat-sign mark in the middle (docs/adr/android-0004). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#5B3FD0" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_background" />
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
