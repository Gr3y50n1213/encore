<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Only the window before Compose draws; every colour on screen comes from the
         token constants (EncoreTheme). Edge to edge is set in MainActivity. The system bars
         are clear; the navigation bar's scrim follows the navigation mode at run time
         (clear for gestures, the system's for buttons), and the app draws into the cutout's short edges;
         each screen pads for the insets itself. -->
    <style name="Theme.Encore" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>