<?xml version="1.0" encoding="utf-8"?>
<!-- The Now Playing widget in the picker (previewLayout, Android 12 and later), redesigned on
     11 November 2026 to match it: the album field behind, a cover, bold text, the level bars
     and the connected previous / play / next buttons at their real sizes. Static demo text and
     art ("Slow Tide", "Ember Cove"), never the person's listening. Only views RemoteViews
     allows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_field"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_preview_cover" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_title"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_artist"
                android:textColor="#C7FFFFFF"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_bars_a"
                android:tint="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_skip_prev_56"
            android:backgroundTint="#29FFFFFF">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/sym_skip_previous_fill"
                android:tint="#FFFFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_sq_18"
            android:backgroundTint="#FFFFFFFF">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/sym_pause_fill"
                android:tint="#FF3D0000" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_skip_next_56"
            android:backgroundTint="#29FFFFFF">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/sym_skip_next_fill"
                android:tint="#FFFFFFFF" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>