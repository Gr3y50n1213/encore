<?xml version="1.0" encoding="utf-8"?>
<!-- Widgets redesign: a diagonal fade over a tile card (widget_card_18), tinted with the
     album's leading color, so each tile carries its own two-stop gradient like the app's
     "Jump back in" card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#00FFFFFF"
        android:startColor="#B3FFFFFF" />
    <corners android:radius="18dp" />
</shape>