<?xml version="1.0" encoding="utf-8"?>
<!-- A diagonal fade over widget_bg_shape, tinted with the album's leading color (or the
     theme's primary container): the two-stop look of the app's "Jump back in" card, for
     widgets below Android 12 and before an album's colors are made. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#00FFFFFF"
        android:startColor="#B3FFFFFF" />
    <corners android:radius="16dp" />
</shape>