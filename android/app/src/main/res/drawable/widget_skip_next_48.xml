<?xml version="1.0" encoding="utf-8"?>
<!-- Next, 48 dp high: inner end 10 dp, outer end fully round: Widgets redesign (11 November 2026). Tinted by the widget. A corner radius over half the shorter side is clamped to a pill, but only for one radius on all four corners: Android scales every corner down when a pair of different radii overflows a side, so the buttons with two radii are one drawable per size. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:topLeftRadius="10dp" android:bottomLeftRadius="10dp" android:topRightRadius="24dp" android:bottomRightRadius="24dp" />
</shape>
