<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up to the cloud or copied to a new device: profile databases hold
     listening history, and tokens live in the Keystore, which never transfers (plan
     sections 12 and 19). Sign-in on a new device starts fresh; the companion server
     carries synced data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
