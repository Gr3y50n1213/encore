<?xml version="1.0" encoding="utf-8"?>
<!-- Permissions: the plan's section 19 list. INTERNET, ACCESS_NETWORK_STATE (Wi-Fi or
     cellular stream quality, offline), WAKE_LOCK (streaming with the screen off) and
     FOREGROUND_SERVICE are install-time permissions Android grants without asking;
     FOREGROUND_SERVICE_MEDIA_PLAYBACK is the plan's own entry. Phase 8 adds
     RUN_USER_INITIATED_JOBS (install-time, approved by the owner on 8 November 2026)
     for downloads the person starts, and POST_NOTIFICATIONS, optional, asked in
     context after the board 25 primer when the first download starts. None is asked
     at launch. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 9: install-time, approved by the owner. Lets a download the person started
         show as a Live Update on Android 16 QPR1 and later (notifications/LiveUpdates.kt). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".EncoreApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Encore">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Phase 8: "Play <name> on Encore" from the phone's assistant (VoicePlay). -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Phase 9 (WP8): touch and hold on the Start a mix tile opens Mixes. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Board 19, item 5: the export file is shared through the system sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <!-- Phase 8: downloads run as jobs (docs/adr/android-0002). -->
        <service
            android:name=".downloads.DownloadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".downloads.DownloadActionReceiver"
            android:exported="false" />

        <!-- Phase 9 (WP4): the sleep timer card's Add 15 min and swipe-away
             (playback/SleepTimerReceiver.kt). Not exported. -->
        <receiver
            android:name=".playback.SleepTimerReceiver"
            android:exported="false" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <!-- Phase 8: the library session Android Auto browses (and the legacy name
                 it still looks for). -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Covers for Android Auto's lists: not exported; each address is granted to
             the one controller that asked (playback/ArtworkProvider.kt). -->
        <provider
            android:name=".playback.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Phase 9 (WP6): the Now Playing widget (Glance). App widget receivers must be
             exported for the launcher; it only redraws from the snapshot file and never
             starts the core. -->
        <receiver
            android:name=".widgets.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="@string/now_playing_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <!-- Phase 9 (WP7): the Mixes and Recently played widgets. Both history widgets
             declare not_keyguard in their provider XML (never on the lock screen). -->
        <receiver
            android:name=".widgets.MixesWidgetReceiver"
            android:exported="true"
            android:label="@string/mixes_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mixes_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.RecentWidgetReceiver"
            android:exported="true"
            android:label="@string/recent_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_widget_info" />
        </receiver>

        <!-- Phase 9 (WP6): a widget's Profile setting. Exported for the widget host; it
             checks the widget ID is one of ours before doing anything. -->
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Encore">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Phase 9 (WP8): the "Start a mix" Quick Settings tile (tile/StartMixTileService.kt).
             Exported because Android binds it, protected by BIND_QUICK_SETTINGS_TILE. Active
             tile: bound only when the app asks for a refresh (WidgetSync) or the panel opens. -->
        <service
            android:name=".tile.StartMixTileService"
            android:exported="true"
            android:icon="@drawable/sym_graphic_eq"
            android:label="@string/tile_start_mix_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Android Auto: a media app (res/xml/automotive_app_desc.xml). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
